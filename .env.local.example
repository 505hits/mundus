NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase environment variables for Mundus Portal

# Server-only. Never use NEXT_PUBLIC_ for the service role key.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical URL of this environment; must also be allowed in Supabase Auth redirects.
MUNDUS_SITE_URL=
# Enable only after applying 202609290001_account_onboarding.sql and verifying email delivery.
MUNDUS_SELF_SIGNUP_ENABLED=false
MUNDUS_INVITATIONS_ENABLED=false

# Payment flows are off until the payments migration, Stripe test checkout, and webhook are verified.
MUNDUS_PAYMENTS_ENABLED=false
MUNDUS_PAYMENTS_LIVE_ENABLED=false
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=

# Schedule-change emails: configure and verify SMTP before enabling.
MUNDUS_EMAIL_NOTIFICATIONS_ENABLED=false
MUNDUS_SMTP_HOST=
MUNDUS_SMTP_PORT=587
MUNDUS_SMTP_USER=
MUNDUS_SMTP_PASSWORD=
MUNDUS_EMAIL_FROM=
# Random server-only value of at least 32 characters for the notification worker.
MUNDUS_NOTIFICATION_SECRET=
